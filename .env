# Rename this file to ".env" and fill in your real key.
# Get a Gemini API key from https://aistudio.google.com/app/apikey

GEMINI_API_KEY=AQ.Ab8RN6IpAmvm6fZNX-cJKXz6NM8uq81QRQlULI-plfqbydzSXQ
# Which Gemini model to use for QnA / Quiz / Summary / Learning Path.
GEMINI_MODEL=gemini-3.1-flash-lite

# Set to "true" to use the local LaMini-Flan-T5-783M model (via transformers)
# for the Explanation module, as described in the original documentation.
# Set to "false" (default, recommended) to use Gemini for explanations too —
# this avoids downloading a ~3GB model and needing torch/transformers.
USE_LOCAL_EXPLAIN_MODEL=false

# Host/port for uvicorn (used when running "python main.py")
HOST=127.0.0.1
PORT=8011